# 환경변수 키 목록. 값은 비워 둔다. 비밀값은 VITE_ 변수에 넣지 않는다

# DMS MCP 서버 주소. setup.sh가 읽어 AI 도구에 등록한다. 값은 디스코드의 .env.local 에서 받는다
DMS_MCP_URL=

# Figma 디자인 파일 주소. 공개 저장소라 값은 디스코드의 .env.local 에서 받는다
FIGMA_FILE_URL=

# Figma 개인 액세스 토큰. scripts/figma.mjs가 디자인을 받을 때 쓴다. 각자 만들고 공유하지 않는다(README "Figma 디자인")
FIGMA_TOKEN=

# 카카오 지도 JavaScript 키. 등록한 도메인에서만 동작하는 공개용 키다. REST·Admin 키는 넣지 않는다
VITE_KAKAO_MAP_KEY=

# SNS 로그인 앱 ID(카카오 REST API 키, 구글 OAuth 클라이언트 ID). 인가 창 주소에 실리는 공개값이다. Client Secret은 넣지 않는다(백엔드 app.sns.*)
# 비워 두면 로컬 개발에서는 인가 창 대신 백엔드 가짜 제공자(code=fake-이름)로 확인한다
VITE_KAKAO_REST_KEY=
VITE_GOOGLE_CLIENT_ID=

# 포트폴리오 데모 계정. 랜딩 팝업에서 고르면 이메일 로그인 칸에 미리 채운다. 브라우저에서 누구나 보는 공개값이다
# 데모 전용 계정만 넣는다(실제 운영자·개인 계정 금지). 관리자 데모는 누구나 관리자 기능을 쓸 수 있게 되므로 백엔드에서 변경을 막은 계정을 쓴다
# 비워 두면 칸이 빈 채로 이메일 로그인 화면만 열린다
VITE_DEMO_MEMBER_EMAIL=
VITE_DEMO_MEMBER_PASSWORD=
VITE_DEMO_ADMIN_EMAIL=
VITE_DEMO_ADMIN_PASSWORD=
